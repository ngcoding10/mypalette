{
  "name": "mypalette",
  "private": true,
  "type": "module",
  "description": "MyPalette: a static web app (no build step). These scripts only run the tests and tools.",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "evaluate": "node tools/evaluate.mjs tools/sample-sessions.json",
    "evaluate:intake": "node tools/evaluate-intake.mjs 30",
    "menu-order": "node tools/menu-order.mjs"
  }
}
